// Afro Commercial Management System — Phase A schema.
//
// Governance rules baked in from day one (per spec):
//   - Soft delete only. `deletedAt` on every business record; nothing is ever
//     physically removed.
//   - Every state-changing operation lands in AuditLog.
//   - Enum values are CODES. Display translation never touches the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER_BOARD
  CEO
  SALES_DIRECTOR
  ACCOUNT_MANAGER
  PRESALES
  ESTIMATION
  PROCUREMENT
  FINANCE
  OPERATIONS
  LEGAL
  PROJECT_MANAGER
  SYSTEM_ADMIN
}

enum DataScope {
  OWN
  TEAM
  BUSINESS_UNIT
  COUNTRY
  LEGAL_ENTITY
  GROUP
}

enum OrgUnitType {
  GROUP
  LEGAL_ENTITY
  COUNTRY
  BUSINESS_UNIT
  DEPARTMENT
  TEAM
}

enum OpportunityStage {
  LEAD_INTAKE
  LEAD_QUALIFICATION
  OPPORTUNITY_QUALIFICATION
  SCOPE_DISCOVERY
  BID_STRATEGY_SOLUTION
  COSTING_SOURCING
  OPERATIONAL_FINANCIAL_REVIEW
  MANAGEMENT_APPROVAL
  PROPOSAL_SUBMISSION
  CLARIFICATIONS_NEGOTIATION
  AWARD_CONTRACTING
  PROJECT_HANDOVER
  ACTUAL_PERFORMANCE_FEEDBACK
}

enum OpportunityStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
  LOST
  CLOSED
}

enum ForecastCategory {
  PIPELINE
  UPSIDE
  BEST_CASE
  COMMIT
  CLOSED_WON
}

enum HealthState {
  GREEN
  AMBER
  RED
}

enum ExitReason {
  NO_BID
  LOST
  CANCELLED
  ON_HOLD
  DISQUALIFIED
}

enum AccountType {
  OPERATOR
  CONTRACTOR
  GOVERNMENT
  ENTERPRISE
  DEVELOPER
  VENDOR
}

enum CreditStatus {
  GOOD
  WATCH
  HOLD
  BLOCKED
}

enum Industry {
  FTTH
  FTTS
  WIRELESS
  FIXED
  SUBMARINE
  MEP
  ELV
  CORE_NETWORK
  IT
  SUPPLY
}

enum LeadSource {
  TENDER_PORTAL
  DIRECT_INVITATION
  REFERRAL
  EXISTING_CLIENT
  MARKETING
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  WORKING
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  SITE_VISIT
  NOTE
  TASK
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
  RESTORE
  STAGE_CHANGE
  STATUS_CHANGE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  /// A Segregation of Duties rule stopped an action. Recorded because a blocked
  /// attempt is evidence in its own right — "nobody tried" and "someone tried"
  /// are different findings.
  SOD_BLOCKED
}

// ---------------------------------------------------------------------------
// Organization & security
// ---------------------------------------------------------------------------

/// Self-referencing tree: Group > Legal Entity > Country > Business Unit > Team.
/// Data scope resolution walks this tree, so depth is deliberately unconstrained.
model OrganizationUnit {
  id        String      @id @default(uuid())
  code      String      @unique
  nameAr    String
  nameEn    String
  nameFr    String?
  type      OrgUnitType
  country   String?
  currency  String?
  parentId  String?
  parent    OrganizationUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("OrgTree")

  users         User[]
  accounts      Account[]
  opportunities Opportunity[]
  leads         Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([type])
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullNameAr   String
  fullNameEn   String
  jobTitle     String?
  phone        String?
  locale       String  @default("ar")
  isActive     Boolean @default(true)

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  managerId String?
  manager   User?  @relation("UserManager", fields: [managerId], references: [id])
  reports   User[] @relation("UserManager")

  roles         UserRole[]
  refreshTokens RefreshToken[]

  ownedAccounts      Account[]              @relation("AccountOwner")
  ownedOpportunities Opportunity[]          @relation("OpportunityOwner")
  ownedLeads         Lead[]                 @relation("LeadOwner")
  teamMemberships    OpportunityTeam[]
  activities         Activity[]
  stageChanges       OpportunityStageHistory[]
  auditEntries       AuditLog[]
  uploadedDocuments  Document[]        @relation("DocumentUploader")
  documentVersions   DocumentVersion[]
  notifications      Notification[]

  ownedAssumptions     Assumption[]     @relation("AssumptionOwner")
  raisedClarifications Clarification[]  @relation("ClarificationRaiser")
  ownedRequirements    BidRequirement[] @relation("RequirementOwner")
  bidAssessments       BidAssessment[]  @relation("BidAssessor")
  bidDecisions         BidAssessment[]  @relation("BidDecider")

  costingScenarios   CostingScenario[] @relation("ScenarioAuthor")
  costingVersions    CostingVersion[]  @relation("VersionAuthor")
  submittedVersions  CostingVersion[]  @relation("VersionSubmitter")
  approvedVersions   CostingVersion[]  @relation("VersionApprover")
  ownedCostPackages  CostPackage[]     @relation("PackageOwner")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orgUnitId])
  @@index([managerId])
}

/// Role assignment carries its own scope: the same person can be an
/// ACCOUNT_MANAGER over their own records and FINANCE over a whole country.
model UserRole {
  id     String    @id @default(uuid())
  userId String
  user   User      @relation(fields: [userId], references: [id])
  role   Role
  scope  DataScope @default(OWN)

  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Accounts & contacts
// ---------------------------------------------------------------------------

model Account {
  id        String  @id @default(uuid())
  code      String  @unique
  legalName String
  tradeName String?

  parentId String?
  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")

  type         AccountType
  industry     Industry?
  country      String
  city         String?
  address      String?
  website      String?
  taxId        String?
  creditStatus CreditStatus @default(GOOD)
  /// Agreed payment terms in days. Feeds approval rules (spec flags long terms).
  paymentTermDays Int?

  ownerId String
  owner   User   @relation("AccountOwner", fields: [ownerId], references: [id])

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  contacts             Contact[]
  opportunities        Opportunity[]
  leads                Lead[]
  activities           Activity[]
  relationshipsFrom    AccountRelationship[] @relation("RelFrom")
  relationshipsTo      AccountRelationship[] @relation("RelTo")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([orgUnitId])
  @@index([country])
  @@index([parentId])
}

model Contact {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  fullName  String
  jobTitle  String?
  email     String?
  phone     String?
  mobile    String?
  /// Decision-making weight, used by relationship mapping.
  influence String?
  isPrimary Boolean @default(false)
  notes     String?

  roles                ContactRole[]
  primaryFor           Opportunity[] @relation("OpportunityPrimaryContact")
  leads                Lead[]
  activities           Activity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
}

/// A contact can hold several distinct roles (technical approver AND
/// commercial signatory), so roles are rows rather than a column.
model ContactRole {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
  roleCode  String
  notes     String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Soft delete plus a unique pair means re-adding a role that was removed
  // restores the original row rather than inserting a second one.
  @@unique([contactId, roleCode])
  @@index([contactId])
}

/// Directed account-to-account link (parent, JV partner, competitor, ...).
model AccountRelationship {
  id       String  @id @default(uuid())
  fromId   String
  from     Account @relation("RelFrom", fields: [fromId], references: [id])
  toId     String
  to       Account @relation("RelTo", fields: [toId], references: [id])
  typeCode String
  notes    String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([fromId, toId, typeCode])
  @@index([fromId])
  @@index([toId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  source      LeadSource
  status      LeadStatus @default(NEW)
  country     String
  industry    Industry?

  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String   @default("USD")

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  /// Set when the lead is promoted; keeps the conversion trail intact.
  convertedOpportunityId String?      @unique
  convertedOpportunity   Opportunity? @relation("LeadConversion", fields: [convertedOpportunityId], references: [id])
  convertedAt            DateTime?

  disqualifyReason String?
  nextStep         String?
  activities       Activity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([orgUnitId])
  @@index([accountId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Opportunities
// ---------------------------------------------------------------------------

model Opportunity {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  primaryContactId String?
  primaryContact   Contact? @relation("OpportunityPrimaryContact", fields: [primaryContactId], references: [id])

  ownerId String
  owner   User   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  // The four independent readings. See packages/shared/src/opportunity.ts.
  stage            OpportunityStage  @default(LEAD_INTAKE)
  status           OpportunityStatus @default(ACTIVE)
  forecastCategory ForecastCategory  @default(PIPELINE)
  health           HealthState       @default(GREEN)

  exitReason    ExitReason?
  exitNotes     String?
  exitedAt      DateTime?

  source   LeadSource?
  country  String
  industry Industry?
  currency String      @default("USD")

  estimatedValue Decimal? @db.Decimal(18, 2)
  estimatedCost  Decimal? @db.Decimal(18, 2)
  proposedPrice  Decimal? @db.Decimal(18, 2)
  awardedValue   Decimal? @db.Decimal(18, 2)
  /// Profit over SELLING PRICE — not markup. Stored so historical bids keep the
  /// margin they were approved at even if the formula is ever revised.
  marginPercent  Decimal? @db.Decimal(6, 2)
  probability    Int?

  /// Bid/No-Bid score out of 100 (spec's weighted model).
  bidNoBidScore Int?
  bidDecision   String?

  scopeSummary     String?
  solutionStrategy String?
  nextStep         String?

  expectedCloseDate DateTime?
  submissionDate    DateTime?
  awardDate         DateTime?

  stageHistory OpportunityStageHistory[]
  team         OpportunityTeam[]
  activities   Activity[]
  convertedFromLead Lead? @relation("LeadConversion")

  scopePackages  ScopePackage[]
  assumptions    Assumption[]
  clarifications Clarification[]
  bids           Bid[]
  assessments    BidAssessment[]
  costingScenarios CostingScenario[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
  @@index([ownerId])
  @@index([orgUnitId])
  @@index([stage])
  @@index([status])
  @@index([forecastCategory])
  @@index([expectedCloseDate])
}

/// Append-only stage trail. Duration between rows powers velocity and
/// bottleneck analytics later; rows are never updated or deleted.
model OpportunityStageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  fromStage OpportunityStage?
  toStage   OpportunityStage
  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id])
  reason      String?
  /// Time spent in fromStage, in hours. Denormalised so trend queries do not
  /// need a self-join over the whole history table.
  durationHours Int?

  createdAt DateTime @default(now())

  @@index([opportunityId])
  @@index([toStage])
}

model OpportunityTeam {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  role          Role
  isLead        Boolean     @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([opportunityId, userId, role])
  @@index([opportunityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Activities
// ---------------------------------------------------------------------------

model Activity {
  id      String       @id @default(uuid())
  type    ActivityType
  subject String
  body    String?

  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
  @@index([opportunityId])
  @@index([userId])
  @@index([dueAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. Never updated, never deleted — not even by SYSTEM_ADMIN.
/// `before`/`after` hold the changed fields only, not whole entities.
model AuditLog {
  id         String      @id @default(uuid())
  entityType String
  entityId   String
  action     AuditAction

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  before Json?
  after  Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Documents (Object storage — MinIO)
// ---------------------------------------------------------------------------

enum DocumentCategory {
  RFQ
  RFP
  TENDER
  QUOTATION
  COSTING
  PROPOSAL
  CONTRACT
  DRAWING
  CORRESPONDENCE
  OTHER
}

/// A logical document attached to any entity (polymorphic via
/// entityType/entityId so accounts, opportunities, contracts etc. can all carry
/// documents without a foreign key each). The file bytes live in object storage,
/// never in the database — the row only points at them.
model Document {
  id         String           @id @default(uuid())
  title      String
  category   DocumentCategory @default(OTHER)
  entityType String
  entityId   String

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  versions          DocumentVersion[]
  /// Points at the newest version for quick reads. Nullable during creation.
  currentVersionId  String?           @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([entityType, entityId])
  @@index([uploadedById])
}

/// Immutable once written. A new upload is a new version, never an overwrite —
/// the spec forbids losing document history. `checksum` is the SHA-256 of the
/// stored bytes, so tampering or truncation in object storage is detectable.
model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  version      Int
  storageKey   String  @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  checksum     String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Release 3 — Scope and Solution
//
// The spec insists scope is structured data, not prose, and that assumptions
// are records rather than a paragraph inside a document. Everything below is
// shaped so a disputed scope is answered with a row and a date.
// ---------------------------------------------------------------------------

enum ScopeCategory {
  SUPPLY
  DESIGN
  CIVIL_WORKS
  INSTALLATION
  TESTING
  ACCEPTANCE
  MAINTENANCE
  PROJECT_MANAGEMENT
  LOGISTICS
  OTHER
}

/// EXCLUDED is not a deletion — an exclusion the customer accepted is worth
/// more at claim time than a package that was never mentioned.
enum ScopeInclusion {
  INCLUDED
  EXCLUDED
  OPTIONAL
}

enum ScopePackageStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
  SUPERSEDED
}

enum Responsibility {
  AFRO
  CUSTOMER
  SHARED
  THIRD_PARTY
}

enum AssumptionCategory {
  TECHNICAL
  COMMERCIAL
  SITE_ACCESS
  PERMITS
  CUSTOMER_INPUT
  SCHEDULE
  SUPPLY_CHAIN
  OTHER
}

enum ConfirmationStatus {
  UNCONFIRMED
  SENT_TO_CUSTOMER
  CONFIRMED
  REJECTED
}

enum ClarificationStatus {
  OPEN
  SENT
  ANSWERED
  CLOSED
  UNANSWERED_AT_SUBMISSION
}

enum ClarificationImpact {
  NONE
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

model ScopePackage {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  name            String
  category        ScopeCategory      @default(OTHER)
  description     String?
  responsibleTeam String?
  inclusion       ScopeInclusion     @default(INCLUDED)
  status          ScopePackageStatus @default(DRAFT)
  /// Display order in the Scope Builder tree; the customer's own ordering often
  /// carries meaning, so it is stored rather than inferred from the name.
  sortOrder       Int                @default(0)

  items ScopeItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([category])
}

/// Self-referencing so the Scope Builder's "Add Child Item" can break a line
/// down (Cabinet Installation > Concrete Base, Crane, Earthing ...) without a
/// second table.
model ScopeItem {
  id       String       @id @default(uuid())
  packageId String
  package  ScopePackage @relation(fields: [packageId], references: [id])

  parentId String?
  parent   ScopeItem?  @relation("ScopeTree", fields: [parentId], references: [id])
  children ScopeItem[] @relation("ScopeTree")

  name                   String
  description            String?
  quantity               Decimal? @db.Decimal(18, 3)
  unit                   String?
  location               String?
  technicalSpecification String?
  responsibility         Responsibility @default(AFRO)
  customerResponsibility String?
  afroResponsibility     String?
  exclusion              String?
  acceptanceCriteria     String?
  sortOrder              Int      @default(0)

  assumptions Assumption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([packageId])
  @@index([parentId])
}

/// "يجب أن تكون الافتراضات بيانات مستقلة" — an assumption nobody confirmed is a
/// risk being carried silently, so confirmation is a tracked state, not a note.
model Assumption {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  scopeItemId String?
  scopeItem   ScopeItem? @relation(fields: [scopeItemId], references: [id])

  description        String
  category           AssumptionCategory @default(OTHER)
  /// What it costs us if the assumption turns out to be wrong.
  impactIfIncorrect  String?
  ownerId            String?
  owner              User?              @relation("AssumptionOwner", fields: [ownerId], references: [id])
  confirmationStatus ConfirmationStatus @default(UNCONFIRMED)
  confirmedAt        DateTime?
  /// Points at a Document — the evidence the customer agreed.
  confirmationDocumentId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([confirmationStatus])
}

model Clarification {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  question     String
  askedTo      String?
  askedAt      DateTime?
  response     String?
  respondedAt  DateTime?
  impact       ClarificationImpact @default(NONE)
  status       ClarificationStatus @default(OPEN)

  raisedById String
  raisedBy   User   @relation("ClarificationRaiser", fields: [raisedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Release 3 — Bids and Tenders
// ---------------------------------------------------------------------------

enum BidType {
  PUBLIC_TENDER
  PRIVATE_TENDER
  RFQ
  RFP
  DIRECT_NEGOTIATION
  FRAMEWORK_CALL_OFF
  RENEWAL
  CHANGE_REQUEST
}

enum BidStatus {
  IDENTIFIED
  PREPARING
  SUBMITTED
  CLARIFICATION
  AWARDED
  LOST
  WITHDRAWN
  CANCELLED
}

enum SubmissionMethod {
  PORTAL
  EMAIL
  HAND_DELIVERY
  COURIER
}

enum RequirementType {
  TECHNICAL
  COMMERCIAL
  LEGAL
  FINANCIAL
  HSE
  ADMINISTRATIVE
}

enum CompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  SUBMITTED
  WAIVED
}

enum BidDecision {
  BID
  NO_BID
  BID_WITH_CONDITIONS
  HOLD
}

/// One opportunity can carry several of these — the original tender, then a
/// change request against the same pursuit.
model Bid {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  tenderNumber        String?
  type                BidType
  status              BidStatus         @default(IDENTIFIED)
  issueDate           DateTime?
  submissionDeadline  DateTime?
  clarificationDeadline DateTime?
  bidBondRequired     Boolean           @default(false)
  bidBondAmount       Decimal?          @db.Decimal(18, 2)
  bidBondCurrency     String?
  submissionMethod    SubmissionMethod?
  submittedAt         DateTime?
  portalReference     String?
  notes               String?

  requirements BidRequirement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([status])
  @@index([submissionDeadline])
}

/// The Bid Checklist. A mandatory requirement left incomplete is the ordinary
/// way a technically strong bid gets disqualified, so completeness is data.
model BidRequirement {
  id    String @id @default(uuid())
  bidId String
  bid   Bid    @relation(fields: [bidId], references: [id])

  type        RequirementType  @default(ADMINISTRATIVE)
  description String
  mandatory   Boolean          @default(true)
  ownerId     String?
  owner       User?            @relation("RequirementOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  status      CompletionStatus @default(NOT_STARTED)
  documentId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([bidId])
  @@index([status])
}

/// A dated Bid/No-Bid assessment. Kept as its own record rather than columns on
/// Opportunity so a re-assessment after new information does not erase the
/// judgement that was made at the time — the trail is the point.
model BidAssessment {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  /// Factor code -> rating 0..5, and the weights in force when scored. Storing
  /// the weights makes a historical score reproducible after they change.
  ratings Json
  weights Json
  score   Decimal @db.Decimal(5, 2)

  /// What the bands suggested, and what a human actually decided. Keeping both
  /// makes an override visible instead of silently overwriting the advice.
  suggestedDecision BidDecision
  decision          BidDecision?
  decisionRationale String?
  decidedById       String?
  decidedBy         User?        @relation("BidDecider", fields: [decidedById], references: [id])
  decidedAt         DateTime?

  assessedById String
  assessedBy   User   @relation("BidAssessor", fields: [assessedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
}

/// Administrable weights. The spec allows tuning but restricts it to Admin or
/// commercial management — the weights decide which pursuits the company walks
/// away from, so they are governed data, not a preference.
model BidScoringWeight {
  factor    String   @id
  weight    Int
  updatedAt DateTime @updatedAt
  updatedById String?
}

// ---------------------------------------------------------------------------
// Release 4 — Costing and Pricing
//
// The hierarchy the spec lays out:
//   Opportunity > Costing Scenario > Costing Version > Cost Package
//              > BOQ Item > Cost Breakdown > Cost Element
//
// The governing rule, in the spec's words: "لا يتم تعديل النسخة المعتمدة، بل
// إنشاء نسخة جديدة" — an approved version is never edited, only superseded.
// ---------------------------------------------------------------------------

enum CostingScenarioType {
  SELF_EXECUTION
  FULL_SUBCONTRACTING
  MIXED_MODEL
  IMPORTED_MATERIALS
  LOCAL_MATERIALS
}

enum CostingVersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum CostPackageType {
  MATERIALS
  CIVIL_WORKS
  INSTALLATION
  PROJECT_MANAGEMENT
  LOGISTICS
  WARRANTY
  OTHER
}

enum CostElementCategory {
  DIRECT_MATERIAL
  DIRECT_LABOR
  EQUIPMENT
  VEHICLE
  SUBCONTRACTOR
  INDIRECT_COST
  FINANCIAL_COST
  CORPORATE
  PROFIT
}

enum ResourceType {
  MATERIAL
  LABOR
  EQUIPMENT
  VEHICLE
  SUBCONTRACT
  SERVICE
}

/// Where a number came from. Kept because it says how much of a bid is
/// evidenced: a quote is somebody else's commitment, an estimate is an opinion.
enum CostSource {
  VENDOR_QUOTE
  SUBCONTRACTOR_QUOTE
  ERP_PURCHASE_PRICE
  HISTORICAL_RATE
  INTERNAL_RATE
  MARKET_BENCHMARK
  MANUAL_ESTIMATE
}

/// An opportunity may be priced several ways at once — self-execution against
/// full subcontracting — and exactly one is carried forward.
model CostingScenario {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  name         String
  type         CostingScenarioType @default(MIXED_MODEL)
  currency     String              @default("USD")
  exchangeRateDate DateTime?
  /// Exactly one scenario per opportunity may be selected; enforced in service.
  isSelected   Boolean             @default(false)
  notes        String?

  createdById String
  createdBy   User   @relation("ScenarioAuthor", fields: [createdById], references: [id])

  versions CostingVersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([isSelected])
}

/// Immutable once approved. `lockedAt` is the gate every write checks.
model CostingVersion {
  id         String          @id @default(uuid())
  scenarioId String
  scenario   CostingScenario @relation(fields: [scenarioId], references: [id])

  versionNumber  Int
  status         CostingVersionStatus @default(DRAFT)
  revisionReason String?

  /// Set when approved. Any write to a locked version is refused, and the way
  /// forward is a new version cloned from it.
  lockedAt   DateTime?
  previousVersionId String?
  previousVersion   CostingVersion?  @relation("VersionChain", fields: [previousVersionId], references: [id])
  nextVersions      CostingVersion[] @relation("VersionChain")

  submittedAt  DateTime?
  submittedById String?
  submittedBy   User?    @relation("VersionSubmitter", fields: [submittedById], references: [id])
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?    @relation("VersionApprover", fields: [approvedById], references: [id])
  rejectionReason String?

  /// Totals cached at approval so an approved bid keeps the numbers it was
  /// approved on even if a library rate changes afterwards.
  totalCost  Decimal? @db.Decimal(18, 2)
  totalPrice Decimal? @db.Decimal(18, 2)
  marginPercent Decimal? @db.Decimal(6, 2)

  createdById String
  createdBy   User   @relation("VersionAuthor", fields: [createdById], references: [id])

  packages CostPackage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([scenarioId, versionNumber])
  @@index([scenarioId])
  @@index([status])
}

model CostPackage {
  id        String         @id @default(uuid())
  versionId String
  version   CostingVersion @relation(fields: [versionId], references: [id])

  code      String?
  name      String
  type      CostPackageType @default(OTHER)
  ownerId   String?
  owner     User?           @relation("PackageOwner", fields: [ownerId], references: [id])
  sortOrder Int             @default(0)

  items BoqItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([versionId])
}

/// Self-referencing: the spec breaks "Cabinet Installation" into concrete base,
/// transport, crane, team, earthing, testing and supervision.
model BoqItem {
  id        String      @id @default(uuid())
  packageId String
  package   CostPackage @relation(fields: [packageId], references: [id])

  parentId String?
  parent   BoqItem?  @relation("BoqTree", fields: [parentId], references: [id])
  children BoqItem[] @relation("BoqTree")

  itemNumber           String?
  description          String
  technicalDescription String?
  quantity             Decimal @db.Decimal(18, 3)
  unit                 String?

  /// What the customer's own BOQ says, when they issued one — kept apart from
  /// our selling numbers so the two can be compared rather than conflated.
  customerRate  Decimal? @db.Decimal(18, 4)
  customerTotal Decimal? @db.Decimal(18, 2)

  /// Rolled up from the breakdown lines; not typed in by hand.
  internalCost Decimal? @db.Decimal(18, 2)
  sellingRate  Decimal? @db.Decimal(18, 4)
  sellingTotal Decimal? @db.Decimal(18, 2)
  grossProfit  Decimal? @db.Decimal(18, 2)
  /// Over selling price. Never markup — see @acms/shared.
  grossMargin  Decimal? @db.Decimal(6, 2)

  sortOrder Int @default(0)

  breakdown CostBreakdown[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([packageId])
  @@index([parentId])
}

model CostBreakdown {
  id        String  @id @default(uuid())
  boqItemId String
  boqItem   BoqItem @relation(fields: [boqItemId], references: [id])

  elementId String?
  element   CostElement? @relation(fields: [elementId], references: [id])
  resourceId String?
  resource   Resource?   @relation(fields: [resourceId], references: [id])

  description      String?
  quantity         Decimal  @db.Decimal(18, 3)
  unit             String?
  unitCost         Decimal  @db.Decimal(18, 4)
  wastePercent     Decimal? @db.Decimal(6, 2)
  productivityRate Decimal? @db.Decimal(18, 3)
  durationDays     Decimal? @db.Decimal(10, 2)
  exchangeRate     Decimal? @db.Decimal(12, 6)
  taxAmount        Decimal? @db.Decimal(18, 2)
  allocationPercent Decimal? @db.Decimal(6, 2)
  /// Computed by the service from the fields above, never sent by a client.
  totalCost        Decimal  @db.Decimal(18, 2)

  source          CostSource @default(MANUAL_ESTIMATE)
  sourceReference String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([boqItemId])
  @@index([source])
}

/// The Cost Element Library. The spec's point is that free-text cost lines make
/// two bids incomparable; a controlled list makes them add up across projects.
model CostElement {
  id       String              @id @default(uuid())
  code     String              @unique
  category CostElementCategory
  nameAr   String
  nameEn   String
  nameFr   String?
  isActive Boolean             @default(true)

  breakdown CostBreakdown[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
}

/// Standard rates, effective-dated. "يجب الاحتفاظ بتاريخ الأسعار، وليس استبدال
/// السعر القديم" — a superseded rate stays queryable, so an old bid can still be
/// explained with the numbers that were true when it was priced.
model Resource {
  id       String       @id @default(uuid())
  code     String
  type     ResourceType
  nameAr   String
  nameEn   String
  unit     String
  standardCost Decimal  @db.Decimal(18, 4)
  currency String       @default("USD")
  country  String?
  orgUnitId String?
  source   CostSource   @default(INTERNAL_RATE)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  breakdown CostBreakdown[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Same code may exist many times over time — one row per price period.
  @@unique([code, effectiveFrom])
  @@index([code])
  @@index([type])
  @@index([effectiveFrom, effectiveTo])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
}

/// A per-user in-app notification. Kept simple and pull-based for now; an email
/// channel and digest scheduling slot in later without changing the shape.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    String
  title   String
  body    String?
  /// Deep-link target so the UI can route to the thing the notice is about.
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Declarative rule: when an event of `eventType` fires, notify whoever matches
/// `roleTarget` (or a specific user) on the given channel. Evaluated by the
/// notifications service; lets governance decide who hears about what without
/// code changes.
model NotificationRule {
  id        String              @id @default(uuid())
  eventType String
  channel   NotificationChannel @default(IN_APP)
  roleTarget Role?
  userTarget String?
  isActive  Boolean             @default(true)
  template  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventType, isActive])
}
