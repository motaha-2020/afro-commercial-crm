// Afro Commercial Management System — Phase A schema.
//
// Governance rules baked in from day one (per spec):
//   - Soft delete only. `deletedAt` on every business record; nothing is ever
//     physically removed.
//   - Every state-changing operation lands in AuditLog.
//   - Enum values are CODES. Display translation never touches the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER_BOARD
  CEO
  SALES_DIRECTOR
  ACCOUNT_MANAGER
  PRESALES
  ESTIMATION
  PROCUREMENT
  FINANCE
  OPERATIONS
  LEGAL
  PROJECT_MANAGER
  SYSTEM_ADMIN
}

enum DataScope {
  OWN
  TEAM
  BUSINESS_UNIT
  COUNTRY
  LEGAL_ENTITY
  GROUP
}

enum OrgUnitType {
  GROUP
  LEGAL_ENTITY
  COUNTRY
  BUSINESS_UNIT
  DEPARTMENT
  TEAM
}

enum OpportunityStage {
  LEAD_INTAKE
  LEAD_QUALIFICATION
  OPPORTUNITY_QUALIFICATION
  SCOPE_DISCOVERY
  BID_STRATEGY_SOLUTION
  COSTING_SOURCING
  OPERATIONAL_FINANCIAL_REVIEW
  MANAGEMENT_APPROVAL
  PROPOSAL_SUBMISSION
  CLARIFICATIONS_NEGOTIATION
  AWARD_CONTRACTING
  PROJECT_HANDOVER
  ACTUAL_PERFORMANCE_FEEDBACK
}

enum OpportunityStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
  LOST
  CLOSED
}

enum ForecastCategory {
  PIPELINE
  UPSIDE
  BEST_CASE
  COMMIT
  CLOSED_WON
}

enum HealthState {
  GREEN
  AMBER
  RED
}

enum ExitReason {
  NO_BID
  LOST
  CANCELLED
  ON_HOLD
  DISQUALIFIED
}

enum CreditStatus {
  GOOD
  WATCH
  HOLD
  BLOCKED
}

enum LeadStatus {
  NEW
  WORKING
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
  RESTORE
  STAGE_CHANGE
  STATUS_CHANGE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  /// A Segregation of Duties rule stopped an action. Recorded because a blocked
  /// attempt is evidence in its own right — "nobody tried" and "someone tried"
  /// are different findings.
  SOD_BLOCKED
}

// ---------------------------------------------------------------------------
// Organization & security
// ---------------------------------------------------------------------------

/// Self-referencing tree: Group > Legal Entity > Country > Business Unit > Team.
/// Data scope resolution walks this tree, so depth is deliberately unconstrained.
model OrganizationUnit {
  id        String      @id @default(uuid())
  code      String      @unique
  nameAr    String
  nameEn    String
  nameFr    String?
  type      OrgUnitType
  country   String?
  currency  String?
  parentId  String?
  parent    OrganizationUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("OrgTree")

  users         User[]
  accounts      Account[]
  opportunities Opportunity[]
  leads         Lead[]
  partners      BusinessPartner[]
  approvalPolicies    ApprovalPolicy[]
  workflowDefinitions WorkflowDefinition[]
  costRules           CostRule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([type])
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullNameAr   String
  fullNameEn   String
  jobTitle     String?
  phone        String?
  locale       String  @default("ar")
  isActive     Boolean @default(true)

  // Admin-created and reset passwords are temporary: the account is forced to
  // set its own on next login, so a shared temp credential never lingers.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  avatarUrl          String?

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  managerId String?
  manager   User?  @relation("UserManager", fields: [managerId], references: [id])
  reports   User[] @relation("UserManager")

  roles         UserRole[]
  refreshTokens RefreshToken[]

  ownedAccounts      Account[]              @relation("AccountOwner")
  ownedOpportunities Opportunity[]          @relation("OpportunityOwner")
  ownedLeads         Lead[]                 @relation("LeadOwner")
  teamMemberships    OpportunityTeam[]
  activities         Activity[]
  stageChanges       OpportunityStageHistory[]
  auditEntries       AuditLog[]
  uploadedDocuments  Document[]        @relation("DocumentUploader")
  documentVersions   DocumentVersion[]
  notifications      Notification[]

  aiConversations     AiConversation[]
  aiSuggestionsMade   AiSuggestion[] @relation("AiSuggestionRequester")
  aiSuggestionsSigned AiSuggestion[] @relation("AiSuggestionApprover")

  ownedAssumptions     Assumption[]     @relation("AssumptionOwner")
  raisedClarifications Clarification[]  @relation("ClarificationRaiser")
  ownedRequirements    BidRequirement[] @relation("RequirementOwner")
  bidAssessments       BidAssessment[]  @relation("BidAssessor")
  bidDecisions         BidAssessment[]  @relation("BidDecider")

  costingScenarios   CostingScenario[] @relation("ScenarioAuthor")
  costingVersions    CostingVersion[]  @relation("VersionAuthor")
  submittedVersions  CostingVersion[]  @relation("VersionSubmitter")
  approvedVersions   CostingVersion[]  @relation("VersionApprover")
  ownedCostPackages  CostPackage[]     @relation("PackageOwner")

  ownedPartners        BusinessPartner[]     @relation("PartnerOwner")
  createdRfqs          Rfq[]                 @relation("RfqCreatedBy")
  receivedQuotations   PartnerQuotation[]    @relation("QuotationReceivedBy")
  selectedQuotations   PartnerQuotation[]    @relation("QuotationSelectedBy")
  quotationEvaluations QuotationEvaluation[] @relation("QuotationEvaluator")
  approvalPolicies   ApprovalPolicy[]  @relation("PolicyAuthor")
  approvalRequests   ApprovalRequest[] @relation("ApprovalRequester")
  approvalActions    ApprovalAction[]  @relation("ApprovalActor")
  approvalDelegations ApprovalAction[] @relation("ApprovalDelegator")
  discountsRequested DiscountRequest[] @relation("DiscountRequester")
  discountsDecided   DiscountRequest[] @relation("DiscountApprover")
  proposalsAuthored  Proposal[]        @relation("ProposalAuthor")
  proposalsSubmitted ProposalVersion[] @relation("ProposalSubmitter")
  awardsRecorded      Award[]             @relation("AwardRecorder")
  contractsAuthored   Contract[]          @relation("ContractAuthor")
  contractsReviewed   Contract[]          @relation("ContractReviewer")
  deviationsPrepared  ContractDeviation[] @relation("DeviationPreparer")
  deviationsApproved  ContractDeviation[] @relation("DeviationApprover")
  handoversAuthored   ProjectHandover[]   @relation("HandoverAuthor")
  handoversManaged    ProjectHandover[]   @relation("HandoverProjectManager")
  handoverItemsOwned  HandoverItem[]      @relation("HandoverItemOwner")
  handoverSignoffs    HandoverSignoff[]   @relation("HandoverSigner")
  costRulesAuthored   CostRule[]          @relation("CostRuleAuthor")
  costRulesApproved   CostRule[]          @relation("CostRuleApprover")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orgUnitId])
  @@index([managerId])
}

/// Role assignment carries its own scope: the same person can be an
/// ACCOUNT_MANAGER over their own records and FINANCE over a whole country.
model UserRole {
  id     String    @id @default(uuid())
  userId String
  user   User      @relation(fields: [userId], references: [id])
  role   Role
  scope  DataScope @default(OWN)

  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Accounts & contacts
// ---------------------------------------------------------------------------

model Account {
  id        String  @id @default(uuid())
  code      String  @unique
  legalName String
  tradeName String?

  parentId String?
  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")

  type         String
  industry     String?
  country      String
  city         String?
  address      String?
  website      String?
  taxId        String?
  creditStatus CreditStatus @default(GOOD)
  /// Agreed payment terms in days. Feeds approval rules (spec flags long terms).
  paymentTermDays Int?

  ownerId String
  owner   User   @relation("AccountOwner", fields: [ownerId], references: [id])

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  contacts             Contact[]
  opportunities        Opportunity[]
  contracts            Contract[]
  leads                Lead[]
  activities           Activity[]
  relationshipsFrom    AccountRelationship[] @relation("RelFrom")
  relationshipsTo      AccountRelationship[] @relation("RelTo")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([orgUnitId])
  @@index([country])
  @@index([parentId])
}

model Contact {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  fullName  String
  jobTitle  String?
  email     String?
  phone     String?
  mobile    String?
  /// Decision-making weight, used by relationship mapping.
  influence String?
  isPrimary Boolean @default(false)
  notes     String?

  roles                ContactRole[]
  primaryFor           Opportunity[] @relation("OpportunityPrimaryContact")
  leads                Lead[]
  activities           Activity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
}

/// A contact can hold several distinct roles (technical approver AND
/// commercial signatory), so roles are rows rather than a column.
model ContactRole {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
  roleCode  String
  notes     String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Soft delete plus a unique pair means re-adding a role that was removed
  // restores the original row rather than inserting a second one.
  @@unique([contactId, roleCode])
  @@index([contactId])
}

/// Directed account-to-account link (parent, JV partner, competitor, ...).
model AccountRelationship {
  id       String  @id @default(uuid())
  fromId   String
  from     Account @relation("RelFrom", fields: [fromId], references: [id])
  toId     String
  to       Account @relation("RelTo", fields: [toId], references: [id])
  typeCode String
  notes    String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([fromId, toId, typeCode])
  @@index([fromId])
  @@index([toId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  source      String
  status      LeadStatus @default(NEW)

  /// Separate from status on purpose. Status answers what happened
  /// commercially — disqualifying a lead states a decision and requires a
  /// written reason. Archiving answers only whether it belongs in today's
  /// working list. Merging them would force a decision nobody made in order to
  /// tidy a screen, and the reason field would fill with "housekeeping".
  archivedAt  DateTime?

  country     String
  industry    String?

  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String   @default("USD")

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  /// Set when the lead is promoted; keeps the conversion trail intact.
  convertedOpportunityId String?      @unique
  convertedOpportunity   Opportunity? @relation("LeadConversion", fields: [convertedOpportunityId], references: [id])
  convertedAt            DateTime?

  disqualifyReason String?
  nextStep         String?
  activities       Activity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([orgUnitId])
  @@index([accountId])
  @@index([status])
  @@index([archivedAt])
}

// ---------------------------------------------------------------------------
// Opportunities
// ---------------------------------------------------------------------------

model Opportunity {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  primaryContactId String?
  primaryContact   Contact? @relation("OpportunityPrimaryContact", fields: [primaryContactId], references: [id])

  ownerId String
  owner   User   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  // The four independent readings. See packages/shared/src/opportunity.ts.
  stage            OpportunityStage  @default(LEAD_INTAKE)
  status           OpportunityStatus @default(ACTIVE)
  forecastCategory ForecastCategory  @default(PIPELINE)
  health           HealthState       @default(GREEN)

  exitReason    ExitReason?
  exitNotes     String?
  exitedAt      DateTime?

  source   String?
  country  String
  industry String?
  currency String      @default("USD")

  estimatedValue Decimal? @db.Decimal(18, 2)
  estimatedCost  Decimal? @db.Decimal(18, 2)
  proposedPrice  Decimal? @db.Decimal(18, 2)
  awardedValue   Decimal? @db.Decimal(18, 2)
  /// Profit over SELLING PRICE — not markup. Stored so historical bids keep the
  /// margin they were approved at even if the formula is ever revised.
  marginPercent  Decimal? @db.Decimal(6, 2)
  probability    Int?

  /// Bid/No-Bid score out of 100 (spec's weighted model).
  bidNoBidScore Int?
  bidDecision   String?

  scopeSummary     String?
  solutionStrategy String?
  nextStep         String?

  /// When the enquiry arrived FROM the customer — not when we recorded it.
  /// createdAt answers a different question (when did our staff type it in),
  /// and using it as a proxy makes an enquiry received in January but logged in
  /// March look like a March enquiry, which destroys any measure of how long we
  /// take to respond. submissionDate is the far end of that same span: the day
  /// our proposal went back out.
  receivedDate      DateTime?
  expectedCloseDate DateTime?
  submissionDate    DateTime?
  awardDate         DateTime?

  stageHistory OpportunityStageHistory[]
  team         OpportunityTeam[]
  activities   Activity[]
  convertedFromLead Lead? @relation("LeadConversion")

  scopePackages  ScopePackage[]
  assumptions    Assumption[]
  clarifications Clarification[]
  bids           Bid[]
  assessments    BidAssessment[]
  costingScenarios CostingScenario[]
  rfqs             Rfq[]
  partnerQuotations PartnerQuotation[]
  approvalPolicies  ApprovalPolicy[]
  approvalRequests  ApprovalRequest[]
  discountRequests  DiscountRequest[]
  proposals         Proposal[]
  awards            Award[]
  contracts         Contract[]
  handovers         ProjectHandover[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
  @@index([ownerId])
  @@index([orgUnitId])
  @@index([stage])
  @@index([status])
  @@index([forecastCategory])
  @@index([expectedCloseDate])
}

/// Append-only stage trail. Duration between rows powers velocity and
/// bottleneck analytics later; rows are never updated or deleted.
model OpportunityStageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  fromStage OpportunityStage?
  toStage   OpportunityStage
  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id])
  reason      String?
  /// Time spent in fromStage, in hours. Denormalised so trend queries do not
  /// need a self-join over the whole history table.
  durationHours Int?

  createdAt DateTime @default(now())

  @@index([opportunityId])
  @@index([toStage])
}

model OpportunityTeam {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  role          Role
  isLead        Boolean     @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([opportunityId, userId, role])
  @@index([opportunityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Activities
// ---------------------------------------------------------------------------

model Activity {
  id      String       @id @default(uuid())
  type    String
  subject String
  body    String?

  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
  @@index([opportunityId])
  @@index([userId])
  @@index([dueAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. Never updated, never deleted — not even by SYSTEM_ADMIN.
/// `before`/`after` hold the changed fields only, not whole entities.
model AuditLog {
  id         String      @id @default(uuid())
  entityType String
  entityId   String
  action     AuditAction

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  before Json?
  after  Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Documents (Object storage — MinIO)
// ---------------------------------------------------------------------------

enum DocumentCategory {
  RFQ
  RFP
  TENDER
  QUOTATION
  COSTING
  PROPOSAL
  CONTRACT
  DRAWING
  CORRESPONDENCE
  OTHER
}

/// A logical document attached to any entity (polymorphic via
/// entityType/entityId so accounts, opportunities, contracts etc. can all carry
/// documents without a foreign key each). The file bytes live in object storage,
/// never in the database — the row only points at them.
model Document {
  id         String           @id @default(uuid())
  title      String
  category   DocumentCategory @default(OTHER)
  entityType String
  entityId   String

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  versions          DocumentVersion[]
  awards            Award[]
  handoverItems     HandoverItem[]
  /// Points at the newest version for quick reads. Nullable during creation.
  currentVersionId  String?           @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([entityType, entityId])
  @@index([uploadedById])
}

/// Immutable once written. A new upload is a new version, never an overwrite —
/// the spec forbids losing document history. `checksum` is the SHA-256 of the
/// stored bytes, so tampering or truncation in object storage is detectable.
model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  version      Int
  storageKey   String  @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  checksum     String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Release 3 — Scope and Solution
//
// The spec insists scope is structured data, not prose, and that assumptions
// are records rather than a paragraph inside a document. Everything below is
// shaped so a disputed scope is answered with a row and a date.
// ---------------------------------------------------------------------------

enum ScopeCategory {
  SUPPLY
  DESIGN
  CIVIL_WORKS
  INSTALLATION
  TESTING
  ACCEPTANCE
  MAINTENANCE
  PROJECT_MANAGEMENT
  LOGISTICS
  OTHER
}

/// EXCLUDED is not a deletion — an exclusion the customer accepted is worth
/// more at claim time than a package that was never mentioned.
enum ScopeInclusion {
  INCLUDED
  EXCLUDED
  OPTIONAL
}

enum ScopePackageStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
  SUPERSEDED
}

enum Responsibility {
  AFRO
  CUSTOMER
  SHARED
  THIRD_PARTY
}

enum AssumptionCategory {
  TECHNICAL
  COMMERCIAL
  SITE_ACCESS
  PERMITS
  CUSTOMER_INPUT
  SCHEDULE
  SUPPLY_CHAIN
  OTHER
}

enum ConfirmationStatus {
  UNCONFIRMED
  SENT_TO_CUSTOMER
  CONFIRMED
  REJECTED
}

enum ClarificationStatus {
  OPEN
  SENT
  ANSWERED
  CLOSED
  UNANSWERED_AT_SUBMISSION
}

enum ClarificationImpact {
  NONE
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

model ScopePackage {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  name            String
  category        ScopeCategory      @default(OTHER)
  description     String?
  responsibleTeam String?
  inclusion       ScopeInclusion     @default(INCLUDED)
  status          ScopePackageStatus @default(DRAFT)
  /// Display order in the Scope Builder tree; the customer's own ordering often
  /// carries meaning, so it is stored rather than inferred from the name.
  sortOrder       Int                @default(0)

  items ScopeItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([category])
}

/// Self-referencing so the Scope Builder's "Add Child Item" can break a line
/// down (Cabinet Installation > Concrete Base, Crane, Earthing ...) without a
/// second table.
model ScopeItem {
  id       String       @id @default(uuid())
  packageId String
  package  ScopePackage @relation(fields: [packageId], references: [id])

  parentId String?
  parent   ScopeItem?  @relation("ScopeTree", fields: [parentId], references: [id])
  children ScopeItem[] @relation("ScopeTree")

  name                   String
  description            String?
  quantity               Decimal? @db.Decimal(18, 3)
  unit                   String?
  location               String?
  technicalSpecification String?
  responsibility         Responsibility @default(AFRO)
  customerResponsibility String?
  afroResponsibility     String?
  exclusion              String?
  acceptanceCriteria     String?
  sortOrder              Int      @default(0)

  assumptions Assumption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([packageId])
  @@index([parentId])
}

/// "يجب أن تكون الافتراضات بيانات مستقلة" — an assumption nobody confirmed is a
/// risk being carried silently, so confirmation is a tracked state, not a note.
model Assumption {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  scopeItemId String?
  scopeItem   ScopeItem? @relation(fields: [scopeItemId], references: [id])

  description        String
  category           AssumptionCategory @default(OTHER)
  /// What it costs us if the assumption turns out to be wrong.
  impactIfIncorrect  String?
  ownerId            String?
  owner              User?              @relation("AssumptionOwner", fields: [ownerId], references: [id])
  confirmationStatus ConfirmationStatus @default(UNCONFIRMED)
  confirmedAt        DateTime?
  /// Points at a Document — the evidence the customer agreed.
  confirmationDocumentId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([confirmationStatus])
}

model Clarification {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  question     String
  askedTo      String?
  askedAt      DateTime?
  response     String?
  respondedAt  DateTime?
  impact       ClarificationImpact @default(NONE)
  status       ClarificationStatus @default(OPEN)

  raisedById String
  raisedBy   User   @relation("ClarificationRaiser", fields: [raisedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Release 3 — Bids and Tenders
// ---------------------------------------------------------------------------

enum BidType {
  PUBLIC_TENDER
  PRIVATE_TENDER
  RFQ
  RFP
  DIRECT_NEGOTIATION
  FRAMEWORK_CALL_OFF
  RENEWAL
  CHANGE_REQUEST
}

enum BidStatus {
  IDENTIFIED
  PREPARING
  SUBMITTED
  CLARIFICATION
  AWARDED
  LOST
  WITHDRAWN
  CANCELLED
}

enum SubmissionMethod {
  PORTAL
  EMAIL
  HAND_DELIVERY
  COURIER
}

enum RequirementType {
  TECHNICAL
  COMMERCIAL
  LEGAL
  FINANCIAL
  HSE
  ADMINISTRATIVE
}

enum CompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  SUBMITTED
  WAIVED
}

enum BidDecision {
  BID
  NO_BID
  BID_WITH_CONDITIONS
  HOLD
}

/// One opportunity can carry several of these — the original tender, then a
/// change request against the same pursuit.
model Bid {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  tenderNumber        String?
  type                BidType
  status              BidStatus         @default(IDENTIFIED)
  issueDate           DateTime?
  submissionDeadline  DateTime?
  clarificationDeadline DateTime?
  bidBondRequired     Boolean           @default(false)
  bidBondAmount       Decimal?          @db.Decimal(18, 2)
  bidBondCurrency     String?
  submissionMethod    SubmissionMethod?
  submittedAt         DateTime?
  portalReference     String?
  notes               String?

  requirements BidRequirement[]
  proposals    Proposal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([status])
  @@index([submissionDeadline])
}

/// The Bid Checklist. A mandatory requirement left incomplete is the ordinary
/// way a technically strong bid gets disqualified, so completeness is data.
model BidRequirement {
  id    String @id @default(uuid())
  bidId String
  bid   Bid    @relation(fields: [bidId], references: [id])

  type        RequirementType  @default(ADMINISTRATIVE)
  description String
  mandatory   Boolean          @default(true)
  ownerId     String?
  owner       User?            @relation("RequirementOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  status      CompletionStatus @default(NOT_STARTED)
  documentId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([bidId])
  @@index([status])
}

/// A dated Bid/No-Bid assessment. Kept as its own record rather than columns on
/// Opportunity so a re-assessment after new information does not erase the
/// judgement that was made at the time — the trail is the point.
model BidAssessment {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  /// Factor code -> rating 0..5, and the weights in force when scored. Storing
  /// the weights makes a historical score reproducible after they change.
  ratings Json
  weights Json
  score   Decimal @db.Decimal(5, 2)

  /// What the bands suggested, and what a human actually decided. Keeping both
  /// makes an override visible instead of silently overwriting the advice.
  /// Null when Afro has not configured the Bid/No-Bid bands: the score is
  /// still real, but where the line falls is theirs to set.
  suggestedDecision BidDecision?
  decision          BidDecision?
  decisionRationale String?
  decidedById       String?
  decidedBy         User?        @relation("BidDecider", fields: [decidedById], references: [id])
  decidedAt         DateTime?

  assessedById String
  assessedBy   User   @relation("BidAssessor", fields: [assessedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
}

/// Administrable weights. The spec allows tuning but restricts it to Admin or
/// commercial management — the weights decide which pursuits the company walks
/// away from, so they are governed data, not a preference.
model BidScoringWeight {
  factor    String   @id
  weight    Int
  updatedAt DateTime @updatedAt
  updatedById String?
}

// ---------------------------------------------------------------------------
// Release 4 — Costing and Pricing
//
// The hierarchy the spec lays out:
//   Opportunity > Costing Scenario > Costing Version > Cost Package
//              > BOQ Item > Cost Breakdown > Cost Element
//
// The governing rule, in the spec's words: "لا يتم تعديل النسخة المعتمدة، بل
// إنشاء نسخة جديدة" — an approved version is never edited, only superseded.
// ---------------------------------------------------------------------------

enum CostingScenarioType {
  SELF_EXECUTION
  FULL_SUBCONTRACTING
  MIXED_MODEL
  IMPORTED_MATERIALS
  LOCAL_MATERIALS
}

enum CostingVersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum CostPackageType {
  MATERIALS
  CIVIL_WORKS
  INSTALLATION
  PROJECT_MANAGEMENT
  LOGISTICS
  WARRANTY
  OTHER
}

enum CostElementCategory {
  DIRECT_MATERIAL
  DIRECT_LABOR
  EQUIPMENT
  VEHICLE
  SUBCONTRACTOR
  INDIRECT_COST
  FINANCIAL_COST
  CORPORATE
  PROFIT
}

enum ResourceType {
  MATERIAL
  LABOR
  EQUIPMENT
  VEHICLE
  SUBCONTRACT
  SERVICE
}

/// Where a number came from. Kept because it says how much of a bid is
/// evidenced: a quote is somebody else's commitment, an estimate is an opinion.
enum CostSource {
  VENDOR_QUOTE
  SUBCONTRACTOR_QUOTE
  ERP_PURCHASE_PRICE
  HISTORICAL_RATE
  INTERNAL_RATE
  MARKET_BENCHMARK
  MANUAL_ESTIMATE
}

/// An opportunity may be priced several ways at once — self-execution against
/// full subcontracting — and exactly one is carried forward.
model CostingScenario {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  name         String
  type         CostingScenarioType @default(MIXED_MODEL)
  currency     String              @default("USD")
  exchangeRateDate DateTime?
  /// Exactly one scenario per opportunity may be selected; enforced in service.
  isSelected   Boolean             @default(false)
  notes        String?

  createdById String
  createdBy   User   @relation("ScenarioAuthor", fields: [createdById], references: [id])

  versions CostingVersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([isSelected])
}

/// Immutable once approved. `lockedAt` is the gate every write checks.
model CostingVersion {
  id         String          @id @default(uuid())
  scenarioId String
  scenario   CostingScenario @relation(fields: [scenarioId], references: [id])

  versionNumber  Int
  status         CostingVersionStatus @default(DRAFT)
  revisionReason String?

  /// Set when approved. Any write to a locked version is refused, and the way
  /// forward is a new version cloned from it.
  lockedAt   DateTime?
  previousVersionId String?
  previousVersion   CostingVersion?  @relation("VersionChain", fields: [previousVersionId], references: [id])
  nextVersions      CostingVersion[] @relation("VersionChain")

  submittedAt  DateTime?
  submittedById String?
  submittedBy   User?    @relation("VersionSubmitter", fields: [submittedById], references: [id])
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?    @relation("VersionApprover", fields: [approvedById], references: [id])
  rejectionReason String?

  /// Totals cached at approval so an approved bid keeps the numbers it was
  /// approved on even if a library rate changes afterwards.
  totalCost  Decimal? @db.Decimal(18, 2)
  totalPrice Decimal? @db.Decimal(18, 2)
  marginPercent Decimal? @db.Decimal(6, 2)

  createdById String
  createdBy   User   @relation("VersionAuthor", fields: [createdById], references: [id])

  packages CostPackage[]
  proposalVersions ProposalVersion[]
  handoverBaselines ProjectHandover[] @relation("HandoverBaseline")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([scenarioId, versionNumber])
  @@index([scenarioId])
  @@index([status])
}

model CostPackage {
  id        String         @id @default(uuid())
  versionId String
  version   CostingVersion @relation(fields: [versionId], references: [id])

  code      String?
  name      String
  type      CostPackageType @default(OTHER)
  ownerId   String?
  owner     User?           @relation("PackageOwner", fields: [ownerId], references: [id])
  sortOrder Int             @default(0)

  items BoqItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([versionId])
}

/// Self-referencing: the spec breaks "Cabinet Installation" into concrete base,
/// transport, crane, team, earthing, testing and supervision.
model BoqItem {
  id        String      @id @default(uuid())
  packageId String
  package   CostPackage @relation(fields: [packageId], references: [id])

  parentId String?
  parent   BoqItem?  @relation("BoqTree", fields: [parentId], references: [id])
  children BoqItem[] @relation("BoqTree")

  itemNumber           String?
  description          String
  technicalDescription String?
  quantity             Decimal @db.Decimal(18, 3)
  unit                 String?

  /// What the customer's own BOQ says, when they issued one — kept apart from
  /// our selling numbers so the two can be compared rather than conflated.
  customerRate  Decimal? @db.Decimal(18, 4)
  customerTotal Decimal? @db.Decimal(18, 2)

  /// Rolled up from the breakdown lines; not typed in by hand.
  internalCost Decimal? @db.Decimal(18, 2)
  sellingRate  Decimal? @db.Decimal(18, 4)
  sellingTotal Decimal? @db.Decimal(18, 2)
  grossProfit  Decimal? @db.Decimal(18, 2)
  /// Over selling price. Never markup — see @acms/shared.
  grossMargin  Decimal? @db.Decimal(6, 2)

  sortOrder Int @default(0)

  breakdown      CostBreakdown[]
  quotationItems PartnerQuotationItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([packageId])
  @@index([parentId])
}

model CostBreakdown {
  id        String  @id @default(uuid())
  boqItemId String
  boqItem   BoqItem @relation(fields: [boqItemId], references: [id])

  elementId String?
  element   CostElement? @relation(fields: [elementId], references: [id])
  resourceId String?
  resource   Resource?   @relation(fields: [resourceId], references: [id])

  description      String?
  quantity         Decimal  @db.Decimal(18, 3)
  unit             String?
  unitCost         Decimal  @db.Decimal(18, 4)
  wastePercent     Decimal? @db.Decimal(6, 2)
  productivityRate Decimal? @db.Decimal(18, 3)
  durationDays     Decimal? @db.Decimal(10, 2)
  exchangeRate     Decimal? @db.Decimal(12, 6)
  taxAmount        Decimal? @db.Decimal(18, 2)
  allocationPercent Decimal? @db.Decimal(6, 2)
  /// Computed by the service from the fields above, never sent by a client.
  totalCost        Decimal  @db.Decimal(18, 2)

  source          CostSource @default(MANUAL_ESTIMATE)
  sourceReference String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([boqItemId])
  @@index([source])
}

/// The Cost Element Library. The spec's point is that free-text cost lines make
/// two bids incomparable; a controlled list makes them add up across projects.
model CostElement {
  id       String              @id @default(uuid())
  code     String              @unique
  category CostElementCategory
  nameAr   String
  nameEn   String
  nameFr   String?
  isActive Boolean             @default(true)

  breakdown CostBreakdown[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
}

/// Standard rates, effective-dated. "يجب الاحتفاظ بتاريخ الأسعار، وليس استبدال
/// السعر القديم" — a superseded rate stays queryable, so an old bid can still be
/// explained with the numbers that were true when it was priced.
model Resource {
  id       String       @id @default(uuid())
  code     String
  type     ResourceType
  nameAr   String
  nameEn   String
  unit     String
  standardCost Decimal  @db.Decimal(18, 4)
  currency String       @default("USD")
  country  String?
  orgUnitId String?
  source   CostSource   @default(INTERNAL_RATE)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  breakdown CostBreakdown[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Same code may exist many times over time — one row per price period.
  @@unique([code, effectiveFrom])
  @@index([code])
  @@index([type])
  @@index([effectiveFrom, effectiveTo])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
}

/// A per-user in-app notification. Kept simple and pull-based for now; an email
/// channel and digest scheduling slot in later without changing the shape.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    String
  title   String
  body    String?
  /// Deep-link target so the UI can route to the thing the notice is about.
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Declarative rule: when an event of `eventType` fires, notify whoever matches
/// `roleTarget` (or a specific user) on the given channel. Evaluated by the
/// notifications service; lets governance decide who hears about what without
/// code changes.
model NotificationRule {
  id        String              @id @default(uuid())
  eventType String
  channel   NotificationChannel @default(IN_APP)
  roleTarget Role?
  userTarget String?
  isActive  Boolean             @default(true)
  template  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventType, isActive])
}

// ---------------------------------------------------------------------------
// Release 5 — Partners and Quotations
//
// The spec settles the shape itself (section 21): "يمكن أن يكون المورد والمقاول
// داخل جدول Business Partner واحد مع أنواع مختلفة". One table, types as rows —
// the company that supplies the cable and also installs it is one relationship
// with one performance history, not two half-records.
// ---------------------------------------------------------------------------

enum PartnerApprovalStatus {
  PROSPECT
  UNDER_QUALIFICATION
  APPROVED
  CONDITIONAL
  SUSPENDED
}

enum RfqStatus {
  DRAFT
  ISSUED
  CLOSED
  CANCELLED
}

enum QuotationTechnicalStatus {
  NOT_REVIEWED
  COMPLIANT
  COMPLIANT_WITH_DEVIATIONS
  NON_COMPLIANT
}

enum QuotationCommercialStatus {
  NOT_REVIEWED
  ACCEPTABLE
  NEEDS_NEGOTIATION
  UNACCEPTABLE
}

enum QuotationCompliance {
  COMPLIANT
  ALTERNATIVE
  DEVIATION
  NOT_QUOTED
}

model BusinessPartner {
  id        String  @id @default(uuid())
  code      String  @unique
  legalName String
  tradeName String?

  country   String
  city      String?
  address   String?
  taxNumber String?
  website   String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  approvalStatus PartnerApprovalStatus @default(PROSPECT)

  /// Four INDEPENDENT readings, never averaged into a stored "overall". A
  /// partner strong technically and weak financially is a specific risk; one
  /// number would hide exactly the half that matters.
  technicalRating  Int?
  commercialRating Int?
  financialRating  Int?
  hseRating        Int?

  /// Blacklisting is a hard gate, not a warning label: the selection endpoint
  /// refuses a blacklisted partner outright.
  isBlacklisted   Boolean   @default(false)
  blacklistReason String?
  blacklistedAt   DateTime?

  notes String?

  ownerId String
  owner   User   @relation("PartnerOwner", fields: [ownerId], references: [id])

  orgUnitId String
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id])

  types         PartnerTypeAssignment[]
  quotations    PartnerQuotation[]
  rfqRecipients RfqRecipient[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([orgUnitId])
  @@index([country])
  @@index([approvalStatus])
}

/// A partner holds several types at once (supplies AND installs), so types are
/// rows. Soft-deleted and re-granted like ContactRole, keeping the unique pair.
model PartnerTypeAssignment {
  id        String          @id @default(uuid())
  partnerId String
  partner   BusinessPartner @relation(fields: [partnerId], references: [id])
  type      String
  notes     String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([partnerId, type])
  @@index([partnerId])
}

/// A request for quotation issued against an opportunity's scope.
model Rfq {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  title       String
  description String?
  status      RfqStatus @default(DRAFT)

  issuedAt DateTime?
  dueAt    DateTime?
  currency String    @default("USD")

  createdById String
  createdBy   User   @relation("RfqCreatedBy", fields: [createdById], references: [id])

  recipients RfqRecipient[]
  quotations PartnerQuotation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([status])
}

model RfqRecipient {
  id        String          @id @default(uuid())
  rfqId     String
  rfq       Rfq             @relation(fields: [rfqId], references: [id])
  partnerId String
  partner   BusinessPartner @relation(fields: [partnerId], references: [id])

  respondedAt   DateTime?
  declinedAt    DateTime?
  declineReason String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([rfqId, partnerId])
  @@index([rfqId])
  @@index([partnerId])
}

/// Section 22's Partner Quotation. Kept apart from the costing tables: a
/// quotation is what a partner said, a cost breakdown is what we decided to
/// carry. Linking them without merging them is what lets a price be traced.
model PartnerQuotation {
  id        String          @id @default(uuid())
  code      String          @unique
  partnerId String
  partner   BusinessPartner @relation(fields: [partnerId], references: [id])

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  rfqId String?
  rfq   Rfq?   @relation(fields: [rfqId], references: [id])

  quotationNumber String?
  quotationDate   DateTime?
  /// Past this date the offer is history, not a current price. The comparison
  /// excludes it and says so rather than quietly leaving it out.
  validUntil      DateTime?

  currency     String  @default("USD")
  paymentTerms String?
  deliveryDays Int?
  warranty     String?
  freightTerms String?
  taxTreatment String?

  totalValue Decimal @default(0) @db.Decimal(18, 2)
  /// Freight, duty and handling on top of the quoted price. The cheapest
  /// quotation is regularly not the cheapest delivered.
  landedAdjustment Decimal? @db.Decimal(18, 2)

  technicalStatus  QuotationTechnicalStatus  @default(NOT_REVIEWED)
  commercialStatus QuotationCommercialStatus @default(NOT_REVIEWED)

  /// Set only through the selection endpoint, which demands a human decision.
  isSelected         Boolean   @default(false)
  selectedAt         DateTime?
  selectedById       String?
  selectedBy         User?     @relation("QuotationSelectedBy", fields: [selectedById], references: [id])
  selectionRationale String?

  receivedById String
  receivedBy   User   @relation("QuotationReceivedBy", fields: [receivedById], references: [id])

  items       PartnerQuotationItem[]
  evaluations QuotationEvaluation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([partnerId])
  @@index([opportunityId])
  @@index([rfqId])
  @@index([validUntil])
}

/// A quoted line, tied to the BOQ item it answers. The spec's exit gate for
/// costing is "عروض الموردين مرتبطة بالبنود" — quotations linked to items — so
/// the link is the point of this table, not an optional extra.
model PartnerQuotationItem {
  id          String           @id @default(uuid())
  quotationId String
  quotation   PartnerQuotation @relation(fields: [quotationId], references: [id])

  boqItemId String?
  boqItem   BoqItem? @relation(fields: [boqItemId], references: [id])

  description String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String?
  unitPrice   Decimal @db.Decimal(18, 4)
  /// Computed by the service from quantity x unit price, never client-supplied.
  totalPrice  Decimal @db.Decimal(18, 2)

  leadTimeDays Int?
  compliance   QuotationCompliance @default(COMPLIANT)
  exception    String?
  notes        String?

  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([quotationId])
  @@index([boqItemId])
}

/// Section 23's Quotation Evaluation. Six scores kept separate, and the weights
/// in force stored on the row — an old comparison must stay readable with the
/// weights that actually produced it, not with today's.
model QuotationEvaluation {
  id          String           @id @default(uuid())
  quotationId String
  quotation   PartnerQuotation @relation(fields: [quotationId], references: [id])

  priceScore     Int?
  technicalScore Int?
  deliveryScore  Int?
  paymentScore   Int?
  qualityScore   Int?
  riskScore      Int?

  /// Computed from the scores and the weights below.
  weightedScore Decimal? @db.Decimal(6, 2)
  /// Snapshot of the weights used, as a code -> weight map.
  weightsUsed   Json?

  recommendation String?

  evaluatorId String
  evaluator   User   @relation("QuotationEvaluator", fields: [evaluatorId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Release 6 — Approvals and Proposals
//
// The spec is unusually direct here (section 28): "لا أنصح بوضع Workflow ثابت
// داخل الكود. نحتاج Workflow قابلًا للتهيئة" — do not hard-code the workflow;
// make it configurable. Afro Group confirmed the same when asked for concrete
// approval limits: there is no single set of numbers, because they differ by
// project, by opportunity and by country, and the responsible manager needs
// room to set them.
//
// So no threshold in this release is a constant in TypeScript. Every one is a
// row a person can edit through a settings screen, and the rules that consume
// them are rows too — "IF Gross Margin < 12% THEN CEO Approval" is data, per
// the spec's own worked example.
//
// Two consequences that are easy to miss, both load-bearing:
//
// Changing a limit is itself a governed act. A limit anyone can raise on their
// own authority is not a limit — instead of asking their director, a manager
// edits the number and approves themselves. That is exactly SOD_08, which has
// sat in @acms/shared marked awaitingRelease: 6 since the first release.
//
// And an approval must keep the thresholds it was granted under. Editing a
// policy tomorrow must not silently make yesterday's approvals non-compliant,
// so the values in force are snapshotted onto the request — the same reason a
// costing version keeps the totals it was approved on.
// ---------------------------------------------------------------------------

/// A configurable threshold. The scope columns are what let one company run
/// different limits per country and per opportunity without a code change.
model ApprovalPolicy {
  id    String            @id @default(uuid())
  key   ApprovalPolicyKey
  /// Numeric limit or threshold, read according to `key`.
  value Decimal           @db.Decimal(18, 4)
  currency String?

  /// Scope, narrowest wins. All null = the group-wide default.
  country       String?
  orgUnitId     String?
  orgUnit       OrganizationUnit? @relation(fields: [orgUnitId], references: [id])
  opportunityId String?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id])

  /// Dated so a change is a new row, never an overwrite — the same treatment
  /// resource rates get, and for the same reason: an old decision has to stay
  /// explainable with the numbers that applied at the time.
  effectiveFrom DateTime
  effectiveTo   DateTime?

  note String?

  createdById String
  createdBy   User   @relation("PolicyAuthor", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([key, country])
  @@index([opportunityId])
  @@index([effectiveFrom])
}

model WorkflowDefinition {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  businessProcess ApprovalProcess
  country         String?
  orgUnitId       String?
  orgUnit         OrganizationUnit? @relation(fields: [orgUnitId], references: [id])
  isActive        Boolean         @default(true)
  version         Int             @default(1)

  steps    WorkflowStep[]
  rules    ApprovalRule[]
  requests ApprovalRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessProcess, country])
}

model WorkflowStep {
  id         String             @id @default(uuid())
  workflowId String
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])

  sequence     Int
  name         String
  approverRole String
  approvalType ApprovalType @default(SINGLE)
  /// Hours allowed before the step is late. The spec asks for an SLA per step
  /// so "time waiting" on the approvals queue means something.
  slaHours       Int?
  isMandatory    Boolean @default(true)
  escalationRole String?

  requests ApprovalRequest[]
  actions  ApprovalAction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([workflowId, sequence])
}

/// "IF Gross Margin < 12% THEN CEO Approval Required" — the spec's example,
/// stored rather than compiled.
model ApprovalRule {
  id         String             @id @default(uuid())
  workflowId String
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])

  conditionField ApprovalConditionField
  operator       ApprovalOperator
  /// Either a fixed number, or the policy key whose current value to read.
  threshold          Decimal?           @db.Decimal(18, 4)
  thresholdPolicyKey ApprovalPolicyKey?

  requiredRole String
  priority     Int     @default(0)
  isActive     Boolean @default(true)
  reason       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([workflowId])
}

model ApprovalRequest {
  id         String             @id @default(uuid())
  code       String             @unique
  workflowId String
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])

  recordType    String
  recordId      String
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  currentStepId String?
  currentStep   WorkflowStep? @relation(fields: [currentStepId], references: [id])

  status ApprovalRequestStatus @default(PENDING)

  /// Why this approval exists at all: which rules fired, and on what numbers.
  triggeredBy Json?
  /// The thresholds in force when the request was raised. Editing a policy
  /// afterwards must never rewrite what an approver was asked to judge.
  policySnapshot Json?

  requestedById String
  requestedBy   User     @relation("ApprovalRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())
  decidedAt     DateTime?
  dueAt         DateTime?

  actions          ApprovalAction[]
  proposalVersions ProposalVersion[] @relation("ProposalApproval")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([recordType, recordId])
  @@index([status])
  @@index([opportunityId])
}

model ApprovalAction {
  id        String          @id @default(uuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id])

  stepId String?
  step   WorkflowStep? @relation(fields: [stepId], references: [id])

  approverId String
  approver   User   @relation("ApprovalActor", fields: [approverId], references: [id])

  decision ApprovalDecision
  /// The spec: "لا موافقات شفوية غير مسجلة" and "كل تعليق يبقى محفوظًا".
  comment String?
  /// What an APPROVED_WITH_CONDITIONS decision actually requires.
  conditions      String?
  delegatedFromId String?
  delegatedFrom   User?   @relation("ApprovalDelegator", fields: [delegatedFromId], references: [id])

  actionDate DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([requestId])
  @@index([approverId])
}

/// Separated from a generic approval because SOD_04 names it specifically:
/// whoever asks for the discount does not grant it.
model DiscountRequest {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  requestedPercent Decimal               @db.Decimal(6, 2)
  fromPrice        Decimal               @db.Decimal(18, 2)
  toPrice          Decimal               @db.Decimal(18, 2)
  justification    String
  status           DiscountRequestStatus @default(PENDING)

  requestedById String
  requestedBy   User      @relation("DiscountRequester", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?     @relation("DiscountApprover", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([status])
}

model Proposal {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  bidId String?
  bid   Bid?   @relation(fields: [bidId], references: [id])

  title String

  versions ProposalVersion[]

  createdById String
  createdBy   User   @relation("ProposalAuthor", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
}

model ProposalVersion {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  versionNumber Int
  type          ProposalType @default(INITIAL)

  /// The spec's hard rule (section 26): "يجب أن يرتبط كل Commercial Proposal
  /// بـCosting Version معتمدة. لا يسمح للمستخدم بإدخال سعر عشوائي لا يرتبط
  /// بالتسعير." A commercial price with no approved costing behind it is the
  /// thing this field exists to make impossible.
  costingVersionId String?
  costingVersion   CostingVersion? @relation(fields: [costingVersionId], references: [id])

  approvalRequestId String?
  approvalRequest   ApprovalRequest? @relation("ProposalApproval", fields: [approvalRequestId], references: [id])

  sellingPrice Decimal?  @db.Decimal(18, 2)
  currency     String    @default("USD")
  validUntil   DateTime?

  /// The commercial terms offered, structured rather than buried in an
  /// attached document. Release 7 compares a contract against the proposal it
  /// claims to embody; with only a price here, every other term was being
  /// compared against nothing and the deviation engine could report on one
  /// field out of six.
  paymentTerms   String?
  durationDays   Int?
  warrantyMonths Int?
  ldPercent      Decimal? @db.Decimal(6, 2)
  liabilityCap   Decimal? @db.Decimal(18, 2)

  status ProposalVersionStatus @default(DRAFT)

  submittedAt      DateTime?
  submittedById    String?
  submittedBy      User?     @relation("ProposalSubmitter", fields: [submittedById], references: [id])
  submissionMethod String?
  submittedTo      String?

  contracts Contract[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
  @@index([status])
}

enum ApprovalPolicyKey {
  /// Below this gross margin the deal needs the escalated approver.
  MIN_GROSS_MARGIN_PERCENT
  /// The floor no selling price may go under without an exception approval.
  MIN_SELLING_PRICE_MARGIN_PERCENT
  /// Deal value above which a higher authority is required.
  APPROVAL_VALUE_LIMIT
  /// Collection period the company is willing to carry, in days.
  MAX_PAYMENT_TERM_DAYS
  /// Discount a salesperson may give before it must be approved.
  MAX_DISCOUNT_PERCENT
  /// Bid/No-Bid score bands — previously provisional constants in the code.
  BID_GO_THRESHOLD
  BID_CONDITIONAL_THRESHOLD
}

enum ApprovalProcess {
  OPPORTUNITY_PRICING
  DISCOUNT
  PROPOSAL_SUBMISSION
  CONTRACT
}

enum ApprovalType {
  SINGLE
  ALL_OF
  ANY_OF
}

enum ApprovalConditionField {
  GROSS_MARGIN_PERCENT
  OPPORTUNITY_VALUE
  PAYMENT_TERM_DAYS
  DISCOUNT_PERCENT
  COUNTRY_IS_NEW
  SINGLE_SOURCE_SUPPLIER
  FOREIGN_CURRENCY
  SCOPE_NOT_READY
}

enum ApprovalOperator {
  LESS_THAN
  LESS_OR_EQUAL
  GREATER_THAN
  GREATER_OR_EQUAL
  EQUALS
  IS_TRUE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  APPROVED_WITH_CONDITIONS
  REJECTED
  RETURNED_FOR_REVISION
  CANCELLED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  RETURN_FOR_REVISION
  APPROVE_WITH_CONDITIONS
}

enum DiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProposalType {
  BUDGETARY
  INITIAL
  REVISED
  BAFO
  FINAL
  TECHNICAL
  COMMERCIAL
  COMBINED
}

enum ProposalVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  SUPERSEDED
  WITHDRAWN
}

// ---------------------------------------------------------------------------
// Release 7 — Award, Contracts and Handover
//
// The rule this release exists to protect is stated in one line (stage 10):
// "لا يجب اعتبار Verbal Award مساويًا لعقد موقع" — a verbal award is not a
// signed contract. So an award is not a boolean. It is a strength, and the
// system refuses to let a phone call authorise the same things a signed
// contract does.
//
// The second rule is the handover (stage 11): "لا تبدأ مسؤولية مدير المشروع
// بمجرد تغيير حالة الفرصة" — a project manager's responsibility does not begin
// because someone flipped a status. It begins when they say they received the
// scope, the baseline and the risks. That is why sign-off is rows of named
// people and dates rather than a column on the opportunity.
//
// The spec is blunt about what this prevents: "أن يفوز فريق المبيعات بالمشروع
// ثم يكتشف مدير المشروع أن السعر أو الجدول غير قابل للتنفيذ."
//
// The ERP cost code lives here too. Afro creates a code per opportunity under
// the project cost centre, and it is created AFTER award — which is exactly
// this release's moment, so the field belongs on the award rather than waiting
// for the integration to be built.
// ---------------------------------------------------------------------------

model Award {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  /// How firm this actually is. The whole point of the enum: a verbal award
  /// and a signed contract are not the same fact.
  type AwardType

  awardedAt   DateTime
  awardedValue Decimal? @db.Decimal(18, 2)
  currency     String   @default("USD")

  /// The customer's own reference — LOI number, PO number, letter reference.
  customerReference String?
  documentId        String?
  document          Document? @relation(fields: [documentId], references: [id])

  /// The code Afro opens under the project cost centre once the work is
  /// awarded. Nullable because the ERP integration does not exist yet and the
  /// code is created by hand until it does — recording it now keeps every
  /// actual cost traceable back to its opportunity the moment the link lands.
  erpCostCode   String?
  erpCostCenter String?

  notes String?

  recordedById String
  recordedBy   User   @relation("AwardRecorder", fields: [recordedById], references: [id])

  contracts Contract[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([type])
}

model Contract {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  awardId String?
  award   Award?  @relation(fields: [awardId], references: [id])

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  /// The proposal this contract is supposed to embody. Deviations are computed
  /// against it, so a contract with no proposal behind it cannot be checked.
  proposalVersionId String?
  proposalVersion   ProposalVersion? @relation(fields: [proposalVersionId], references: [id])

  contractNumber String?
  legalEntity    String?
  type           ContractType @default(LUMP_SUM)

  contractValue Decimal? @db.Decimal(18, 2)
  currency      String   @default("USD")

  startDate DateTime?
  endDate   DateTime?

  paymentTerms    String?
  retentionPercent Decimal? @db.Decimal(6, 2)
  advancePercent   Decimal? @db.Decimal(6, 2)
  warrantyMonths   Int?
  /// Liquidated damages. Kept as its own field because it is one of the terms
  /// most often changed between proposal and contract.
  ldPercent        Decimal? @db.Decimal(6, 2)
  liabilityCap     Decimal? @db.Decimal(18, 2)
  governingLaw     String?

  status ContractStatus @default(DRAFT)

  /// Set when a person has actually compared the contract to the proposal.
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ContractReviewer", fields: [reviewedById], references: [id])

  signedAt DateTime?

  clauses    ContractClause[]
  deviations ContractDeviation[]
  handovers  ProjectHandover[]

  createdById String
  createdBy   User   @relation("ContractAuthor", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([accountId])
  @@index([status])
}

model ContractClause {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  clauseType String
  clauseText String
  riskLevel  RiskLevel @default(MEDIUM)
  owner      String?
  mitigation String?
  isApproved Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([contractId])
}

/// What the contract says versus what we offered. The spec asks the system to
/// "إظهار Contract Deviations" across price, quantities, payment terms,
/// duration, warranty, penalties, liabilities, taxes and exclusions.
model ContractDeviation {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  field         DeviationField
  /// Free text for a clause that has no structured field.
  clauseName    String?
  proposalValue String?
  contractValue String?
  impact        String?
  riskLevel     RiskLevel               @default(MEDIUM)
  status        DeviationStatus         @default(OPEN)

  /// SOD_06: whoever prepares the deviation is not its final approver.
  preparedById String
  preparedBy   User   @relation("DeviationPreparer", fields: [preparedById], references: [id])
  approvedById String?
  approvedBy   User?  @relation("DeviationApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  decisionNote String?

  /// True when the system found it by comparing, false when a person added it.
  isDetected Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([contractId])
  @@index([status])
}

model ProjectHandover {
  id            String      @id @default(uuid())
  code          String      @unique
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])

  /// The costing version the project is held to. Without it "did we make the
  /// margin we priced?" has no baseline to ask against.
  costBaselineVersionId String?
  costBaselineVersion   CostingVersion? @relation("HandoverBaseline", fields: [costBaselineVersionId], references: [id])

  projectManagerId String?
  projectManager   User?   @relation("HandoverProjectManager", fields: [projectManagerId], references: [id])

  plannedStartDate DateTime?
  handoverDate     DateTime?
  status           HandoverStatus @default(DRAFT)

  items    HandoverItem[]
  signoffs HandoverSignoff[]

  createdById String
  createdBy   User   @relation("HandoverAuthor", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([opportunityId])
  @@index([status])
}

model HandoverItem {
  id         String          @id @default(uuid())
  handoverId String
  handover   ProjectHandover @relation(fields: [handoverId], references: [id])

  category HandoverCategory
  name     String
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  responsibleId String?
  responsible   User?   @relation("HandoverItemOwner", fields: [responsibleId], references: [id])

  isComplete Boolean @default(false)
  /// A pack item that is genuinely not applicable is different from one nobody
  /// has done. Marking it so requires saying why.
  notApplicable       Boolean @default(false)
  notApplicableReason String?
  comment             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([handoverId])
  @@index([category])
}

/// One row per party. The spec names Sales, Commercial, Finance, Operations,
/// Procurement and the Project Manager — and the PM's is the one that matters
/// most, because their responsibility starts when they accept, not when a
/// status changes.
model HandoverSignoff {
  id         String          @id @default(uuid())
  handoverId String
  handover   ProjectHandover @relation(fields: [handoverId], references: [id])

  party HandoverParty

  signedById String?
  signedBy   User?     @relation("HandoverSigner", fields: [signedById], references: [id])
  signedAt   DateTime?
  /// A refusal is as informative as an acceptance, and needs its reason.
  isAccepted Boolean?
  comment    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([handoverId, party])
  @@index([handoverId])
}

enum AwardType {
  VERBAL_AWARD
  LETTER_OF_INTENT
  PURCHASE_ORDER
  CONTRACT_RECEIVED
  CONTRACT_SIGNED
  NOTICE_TO_PROCEED
}

enum ContractType {
  LUMP_SUM
  UNIT_RATE
  COST_PLUS
  FRAMEWORK
  SUPPLY_ONLY
  SUPPLY_AND_INSTALL
  SERVICE
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  REVIEWED
  SIGNED
  ACTIVE
  CLOSED
  CANCELLED
}

enum DeviationField {
  PRICE
  QUANTITIES
  PAYMENT_TERMS
  DURATION
  WARRANTY
  PENALTIES
  LIABILITIES
  TAXES
  EXCLUSIONS
  NEW_CLAUSE
}

enum DeviationStatus {
  OPEN
  ACCEPTED
  REJECTED
  MITIGATED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HandoverStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_SIGNOFF
  COMPLETED
  REJECTED
}

enum HandoverCategory {
  CONTRACT
  BOQ
  COST_BASELINE
  SCOPE
  ASSUMPTIONS
  EXCLUSIONS
  RISKS
  PAYMENT
  SUPPLIERS
  SUBCONTRACTORS
  SCHEDULE
  CUSTOMER_CONTACTS
  DRAWINGS
  PERMITS
}

enum HandoverParty {
  SALES
  COMMERCIAL
  FINANCE
  OPERATIONS
  PROCUREMENT
  PROJECT_MANAGER
  LEGAL
