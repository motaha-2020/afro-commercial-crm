/// The spec's Cost Rule table (section 18). Overheads are rules rather than one
/// percentage because "لا أنصح بوضع نسبة G&A واحدة على كل شيء" — one rate on
/// everything makes a bid in a cheap country subsidise one in an expensive
/// country while both look correctly priced.
model CostRule {
  id       String            @id @default(uuid())
  code     String            @unique
  name     String
  category CostRuleCategory
  method   CostRuleMethod

  /// A percentage for the percent methods, an amount for the others.
  value    Decimal @db.Decimal(18, 4)
  currency String?

  /// Scope, narrowest wins within a category.
  country   String?
  orgUnitId String?
  orgUnit   OrganizationUnit? @relation(fields: [orgUnitId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// Section 19's principle, which governs here too: "النظام لا يقرر المعالجة
  /// المحاسبية وحده، بل يطبق قواعد معتمدة من Finance." A draft rule is a
  /// proposal and never reaches a bid.
  approvalStatus CostRuleApprovalStatus @default(DRAFT)
  approvedById   String?
  approvedBy     User?                  @relation("CostRuleApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectionReason String?

  note String?

  createdById String
  createdBy   User   @relation("CostRuleAuthor", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category, country])
  @@index([approvalStatus])
  @@index([effectiveFrom])
}

enum CostRuleCategory {
  G_AND_A
  OVERHEAD
  FINANCING
  RISK_PROVISION
  INSURANCE
}

enum CostRuleMethod {
  PERCENT_OF_DIRECT_COST
  PERCENT_OF_REVENUE
  FIXED_AMOUNT
  MONTHLY_RATE
}

enum CostRuleApprovalStatus {
  DRAFT
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// AI Enterprise Assistant — shared infrastructure (orchestrator, memory, audit)
// Specialist agents (sales/financial/document/... intelligence) plug into this
// layer later; nothing here is agent-specific.
// ---------------------------------------------------------------------------

/// One assistant session. Holds no business data itself — just threads
/// AiMessages together so the orchestrator can rebuild short-term context.
model AiConversation {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  title  String?

  messages    AiMessage[]
  suggestions AiSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])

  role    AiMessageRole
  content String

  /// Router bookkeeping — which tier/provider/model answered, if any (empty
  /// for USER/SYSTEM turns). Kept small; the full request is not stored.
  task     String?
  provider String?
  model    String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// A recommendation an agent produced that changes real data. Nothing here
/// touches the target record until a human (or a policy that allows
/// auto-execution) approves it — this is the "human in the loop" gate the
/// orchestrator sits in front of every agent action.
enum AiSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AiSuggestion {
  id String @id @default(uuid())

  conversationId String?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id])

  /// Which agent produced this and what it targets — e.g. agentKey
  /// "sales-intelligence", entityType "Opportunity". Both are free-form
  /// strings so new agents don't need a schema migration to plug in.
  agentKey   String
  entityType String
  entityId   String?

  userId String
  user   User   @relation("AiSuggestionRequester", fields: [userId], references: [id])

  originalData    Json?
  recommendation  Json
  suggestedChange Json?
  confidenceScore Float

  status AiSuggestionStatus @default(PENDING)

  approverId String?
  approver   User?     @relation("AiSuggestionApprover", fields: [approverId], references: [id])
  approvedAt DateTime?
  rejectionReason String?

  executionStatus String?
  executedAt      DateTime?
  executionError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([agentKey, entityType])
}

// ---------------------------------------------------------------------------
// Reference lists — the dropdown values an administrator controls
//
// The spec keeps controlled vocabularies in one place so a value means the same
// thing on every screen. That part does not change; what changes is who may
// edit them. Values that are only labels move out of the code and into these
// two tables, so adding an industry no longer needs a developer.
//
// Values the code branches on stay declared in code and are marked isSystem
// here: renaming and reordering them is safe, removing them is not — a stage
// nothing knows how to price is worse than a missing stage.
// ---------------------------------------------------------------------------

model RefList {
  key String @id

  labelEn String
  labelAr String
  labelFr String

  /// False for lists whose values carry behaviour: an administrator may retitle
  /// and reorder them, but a new value would arrive with no code behind it.
  allowsNewItems Boolean @default(true)

  /// Why this list refuses new values, shown on the screen rather than left for
  /// the administrator to discover by finding the button disabled.
  lockedReason String?

  items RefListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefListItem {
  id      String  @id @default(uuid())
  listKey String
  list    RefList @relation(fields: [listKey], references: [key])

  /// Stable across renames — stored on business records and never rewritten,
  /// so retitling "FTTH" leaves every account that referenced it intact.
  code String

  labelEn String
  labelAr String
  labelFr String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// Shipped with the product. Deactivating one is allowed and hides it from
  /// new records; removing one is not, because code may still name it.
  isSystem Boolean @default(false)

  /// Soft delete only, as everywhere else: a record created last year still has
  /// to render the value it was given.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listKey, code])
  @@index([listKey, isActive, sortOrder])
}
