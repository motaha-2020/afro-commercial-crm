# ---- AI providers ----
# OpenAI is the default. That means the questions people ask, and the
# opportunity codes, values and margins the tools return to answer them, leave
# the network on every call. It is a data-residency decision, not a tuning one.
#
# To keep everything inside the network, set AI_DEFAULT_PROVIDER=ollama below.
# Ollama runs on this host, needs no key, and is always available as the
# fallback when no cloud key is configured.
#   ollama pull qwen2.5:14b     # must support tool calling; the agents need it
OLLAMA_BASE_URL=http://localhost:11434

# openai | ollama | gemini | xai  — applies to all three tiers at once.
AI_DEFAULT_PROVIDER=openai

# xAI (Grok) — OpenAI-compatible API. Needs credits at console.x.ai before use.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# OpenAI — OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Gemini — uses Google's OpenAI-compatibility endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Per-tier overrides, format "provider:model" (fast|balanced|reasoning). These
# beat AI_DEFAULT_PROVIDER for one tier only. An override naming a provider
# with no key is ignored with a warning, model and all.
# AI_ROUTE_FAST=ollama:qwen2.5:7b
# AI_ROUTE_BALANCED=openai:gpt-4o-mini
# AI_ROUTE_REASONING=openai:gpt-4o
