# ---- Database ----
POSTGRES_USER=acms
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=acms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://acms:change_me_locally@localhost:5432/acms?schema=public

# ---- API ----
API_PORT=4000
NODE_ENV=development

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Object storage (MinIO) ----
MINIO_ROOT_USER=acms
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=acms-documents

# ---- AI providers (router picks the cheapest fitting provider/model per task tier) ----
# xAI (Grok) — OpenAI-compatible API. Needs credits at console.x.ai before use.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# OpenAI — OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Gemini — uses Google's OpenAI-compatibility endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional per-tier overrides, format "provider:model" (fast|balanced|reasoning)
# Defaults: fast=gemini:gemini-flash-latest, balanced=openai:gpt-4o-mini, reasoning=openai:gpt-4o
# AI_ROUTE_FAST=gemini:gemini-flash-latest
# AI_ROUTE_BALANCED=xai:grok-4-fast-reasoning
# AI_ROUTE_REASONING=xai:grok-4
